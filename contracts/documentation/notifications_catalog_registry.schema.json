{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://people.local/contracts/documentation/notifications_catalog_registry.schema.json",
  "title": "People Intake Catalog 6 Notifications Foundation Registry",
  "type": "object",
  "required": [
    "documentSetId",
    "documentId",
    "version",
    "status",
    "scope",
    "canonicalPath",
    "contentSha256",
    "principleCount",
    "principles",
    "channelCount",
    "channels",
    "priorityCount",
    "priorities",
    "recipientTypeCount",
    "recipientTypes",
    "expirationPolicyCount",
    "expirationPolicies",
    "seededNotificationCount",
    "seededNotifications",
    "lockedDecisionCount",
    "lockedDecisions",
    "overallReadinessPercent",
    "nextCatalogId",
    "prohibitions"
  ],
  "additionalProperties": false,
  "properties": {
    "documentSetId": { "type": "string", "const": "PEOPLE-CATALOG-LIBRARY-1.0" },
    "documentId": { "type": "string", "const": "PEOPLE-CATALOG-06-NOTIFICATIONS-1.0" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "scope": {
      "type": "string",
      "const": "FOUNDATION_CONTRACT_WITH_SEEDED_NOTIFICATIONS"
    },
    "canonicalPath": { "type": "string" },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "principleCount": { "type": "integer", "const": 10 },
    "principles": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^NOTIFY-PRINCIPLE-\\d{3}$" }
    },
    "channelCount": { "type": "integer", "const": 5 },
    "channels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "priorityCount": { "type": "integer", "const": 4 },
    "priorities": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "recipientTypeCount": { "type": "integer", "const": 6 },
    "recipientTypes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "expirationPolicyCount": { "type": "integer", "const": 4 },
    "expirationPolicies": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "seededNotificationCount": { "type": "integer", "const": 9 },
    "seededNotifications": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["notificationId", "canonicalName"],
        "additionalProperties": false,
        "properties": {
          "notificationId": {
            "type": "string",
            "pattern": "^NOTIFY-[A-Z]+-\\d{3}$"
          },
          "canonicalName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
        }
      }
    },
    "lockedDecisionCount": { "type": "integer", "const": 15 },
    "lockedDecisions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "type": "string" }
    },
    "overallReadinessPercent": { "type": "integer", "const": 98 },
    "nextCatalogId": {
      "type": "string",
      "const": "PEOPLE-CATALOG-07-BACKGROUND-JOBS-1.0"
    },
    "prohibitions": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string" }
    }
  }
}
