{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://people.local/contracts/documentation/database_table_registry.schema.json",
  "title": "People Intake Volume 9 Table Registry",
  "type": "object",
  "required": [
    "documentId",
    "version",
    "status",
    "canonicalPath",
    "contentSha256",
    "principles",
    "deferredDecisions",
    "lockedDecisionCount",
    "tableCount",
    "tables",
    "families",
    "prohibitions"
  ],
  "additionalProperties": false,
  "properties": {
    "documentId": { "type": "string", "const": "PEOPLE-VOLUME-09-DATABASE-SPECIFICATIONS-1.0" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "canonicalPath": { "type": "string" },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "principles": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^DB-PRINCIPLE-\\d{3}$" }
    },
    "deferredDecisions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "type": "string", "pattern": "^DB-DEC-\\d{3}$" }
    },
    "lockedDecisionCount": { "type": "integer", "const": 40 },
    "tableCount": { "type": "integer", "minimum": 40 },
    "appendOnlyCount": { "type": "integer", "minimum": 1 },
    "tables": {
      "type": "array",
      "minItems": 40,
      "items": {
        "type": "object",
        "required": ["tableName", "optional", "appendOnly", "mentioned"],
        "additionalProperties": false,
        "properties": {
          "tableName": { "type": "string" },
          "optional": { "type": "boolean" },
          "appendOnly": { "type": "boolean" },
          "mentioned": { "type": "boolean" }
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["family", "tables"],
        "additionalProperties": false,
        "properties": {
          "family": { "type": "string" },
          "tables": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "prohibitions": {
      "type": "array",
      "minItems": 9,
      "items": { "type": "string" }
    }
  }
}
