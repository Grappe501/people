{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://people.local/contracts/documentation/data_retention_catalog_registry.schema.json",
  "title": "People Intake Catalog 8 Data Retention Foundation Registry",
  "type": "object",
  "required": [
    "documentSetId",
    "documentId",
    "version",
    "status",
    "scope",
    "canonicalPath",
    "contentSha256",
    "principleCount",
    "principles",
    "classificationCount",
    "classifications",
    "domainCount",
    "domains",
    "retentionStateCount",
    "retentionStates",
    "seededRetentionCount",
    "seededRetentionRules",
    "lockedDecisionCount",
    "lockedDecisions",
    "overallReadinessPercent",
    "nextCatalogId",
    "prohibitions"
  ],
  "additionalProperties": false,
  "properties": {
    "documentSetId": { "type": "string", "const": "PEOPLE-CATALOG-LIBRARY-1.0" },
    "documentId": {
      "type": "string",
      "const": "PEOPLE-CATALOG-08-DATA-RETENTION-1.0"
    },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "scope": {
      "type": "string",
      "const": "FOUNDATION_CONTRACT_WITH_SEEDED_RETENTION_RULES"
    },
    "canonicalPath": { "type": "string" },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "principleCount": { "type": "integer", "const": 10 },
    "principles": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^RETAIN-PRINCIPLE-\\d{3}$" }
    },
    "classificationCount": { "type": "integer", "const": 5 },
    "classifications": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "domainCount": { "type": "integer", "const": 22 },
    "domains": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": { "type": "string" }
    },
    "retentionStateCount": { "type": "integer", "const": 5 },
    "retentionStates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "seededRetentionCount": { "type": "integer", "const": 4 },
    "seededRetentionRules": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["retentionId", "label"],
        "additionalProperties": false,
        "properties": {
          "retentionId": {
            "type": "string",
            "pattern": "^RETAIN-[A-Z]+-\\d{3}$"
          },
          "label": { "type": "string" }
        }
      }
    },
    "lockedDecisionCount": { "type": "integer", "const": 15 },
    "lockedDecisions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "type": "string" }
    },
    "overallReadinessPercent": { "type": "integer", "const": 99 },
    "nextCatalogId": {
      "type": "string",
      "const": "PEOPLE-CATALOG-09-TRACEABILITY-1.0"
    },
    "prohibitions": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string" }
    }
  }
}
