{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://people.local/contracts/documentation/audit_event_catalog_registry.schema.json",
  "title": "People Intake Catalog 3 Audit Event Foundation Registry",
  "type": "object",
  "required": [
    "documentSetId",
    "documentId",
    "version",
    "status",
    "scope",
    "canonicalPath",
    "contentSha256",
    "principleCount",
    "principles",
    "domainCount",
    "domains",
    "seededEventCount",
    "seededEvents",
    "lockedDecisionCount",
    "lockedDecisions",
    "overallReadinessPercent",
    "nextCatalogId",
    "prohibitions"
  ],
  "additionalProperties": false,
  "properties": {
    "documentSetId": { "type": "string", "const": "PEOPLE-CATALOG-LIBRARY-1.0" },
    "documentId": { "type": "string", "const": "PEOPLE-CATALOG-03-AUDIT-EVENTS-1.0" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "scope": { "type": "string", "const": "FOUNDATION_CONTRACT_WITH_SEEDED_EVENTS" },
    "canonicalPath": { "type": "string" },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "principleCount": { "type": "integer", "const": 10 },
    "principles": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^AUDIT-PRINCIPLE-\\d{3}$" }
    },
    "domainCount": { "type": "integer", "const": 22 },
    "domains": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": { "type": "string" }
    },
    "seededEventCount": { "type": "integer", "const": 6 },
    "seededEvents": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["eventId", "canonicalName", "domain"],
        "additionalProperties": false,
        "properties": {
          "eventId": { "type": "string", "pattern": "^AUDIT-[A-Z]+-\\d{3}$" },
          "canonicalName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "domain": { "type": "string" }
        }
      }
    },
    "lockedDecisionCount": { "type": "integer", "const": 15 },
    "lockedDecisions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "type": "string" }
    },
    "overallReadinessPercent": { "type": "integer", "const": 98 },
    "nextCatalogId": { "type": "string", "const": "PEOPLE-CATALOG-04-CONFIGURATION-1.0" },
    "prohibitions": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string" }
    }
  }
}
