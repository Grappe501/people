{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://people.local/contracts/documentation/ui_screen_registry.schema.json",
  "title": "People Intake Volume 11 Screen Registry",
  "type": "object",
  "required": [
    "documentId",
    "version",
    "status",
    "canonicalPath",
    "contentSha256",
    "workspaces",
    "lockedDecisionCount",
    "deferredDecisions",
    "screenCount",
    "screens",
    "accessibilityTarget",
    "prohibitions"
  ],
  "additionalProperties": false,
  "properties": {
    "documentId": { "type": "string", "const": "PEOPLE-VOLUME-11-USER-INTERFACE-SPECIFICATIONS-1.0" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "canonicalPath": { "type": "string" },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workspaces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "lockedDecisionCount": { "type": "integer", "const": 40 },
    "deferredDecisions": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": { "type": "string", "pattern": "^UI-DEC-\\d{3}$" }
    },
    "screenCount": { "type": "integer", "minimum": 50 },
    "screens": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "required": ["screenName", "group"],
        "additionalProperties": false,
        "properties": {
          "screenName": { "type": "string" },
          "group": { "type": "string" }
        }
      }
    },
    "accessibilityTarget": { "type": "string" },
    "prohibitions": {
      "type": "array",
      "minItems": 11,
      "items": { "type": "string" }
    }
  }
}
