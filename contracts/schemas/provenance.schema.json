{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://people.local/schemas/provenance.schema.json",
  "title": "Provenance",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "source_system",
    "entry_id"
  ],
  "properties": {
    "page_id": {
      "type": "string"
    },
    "match_resolution_id": {
      "type": "string"
    },
    "entry_id": {
      "type": "string"
    },
    "batch_id": {
      "type": "string"
    },
    "source_system": {
      "type": "string",
      "const": "PEOPLE_INTAKE"
    },
    "source_image_id": {
      "type": "string"
    }
  },
  "note": "Conceptual contract for PEOPLE-DATA-MATCHING-STORAGE-DESIGN-1.0. Not a live database schema."
}
